{
  "name": "git-pinned-commit-highlighter",
  "displayName": "Git Pinned Diff",
  "description": "Pin a branch, tag or commit and see every change since it in the gutter and the Source Control view.",
  "version": "0.1.0",
  "publisher": "mashurr",
  "icon": "icon.png",
    "repository": {
      "type": "git",
      "url": "https://github.com/mashurr/git-pinned-commit-highlighter.git"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "SCM Providers",
    "Other"
  ],
  "keywords": [
    "git",
    "diff",
    "compare",
    "branch",
    "commit",
    "tag",
    "gutter",
    "quick diff"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "pinned-commit-highlighter.togglePinnedCommit",
        "title": "Git Pinned Diff: Pin a Branch, Tag or Commit"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src"
  },
  "devDependencies": {
    "@types/vscode": "^1.90.0",
    "@types/node": "20.x",
    "eslint": "^9.25.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0"
  }
}