{
  "name": "git-pinned-commit-highlighter",
  "displayName": "Git Pinned Commit Highlighter",
  "description": "Highlights file changes compared to a pinned Git commit directly in the editor.",
  "version": "0.0.1",
  "publisher": "mashurr",
  "icon": "icon.png",
    "repository": {
      "type": "git",
      "url": "https://github.com/mashurr/git-pinned-commit-highlighter.git"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "pinned-commit-highlighter.togglePinnedCommit",
        "title": "Toggle Pinned Commit"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src"
  },
  "devDependencies": {
    "@types/vscode": "^1.90.0",
    "@types/node": "20.x",
    "eslint": "^9.25.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0"
  }
}